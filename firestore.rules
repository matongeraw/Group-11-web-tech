rules_version = '2';

// Security rules for the Africa University portal prototype (static site).
// Paste this whole file into Firebase console > Firestore Database > Rules > Publish.
//
// IMPORTANT: the static site has a demo login only (no real accounts), so these
// rules cannot tell a student from a lecturer. Anyone who opens the site can read
// and change the sample data below. Use SAMPLE DATA ONLY - never real student
// records - until real sign-in (Firebase Authentication) is added.

service cloud.firestore {
  match /databases/{database}/documents {

    // Workflow lists the portal reads and writes.
    match /verifications/{id}           { allow read, write: if true; }
    match /referenceLetters/{id}        { allow read, write: if true; }
    match /transcripts/{id}             { allow read, write: if true; }
    match /verifiers/{id}               { allow read, write: if true; }
    match /logbooks/{id}                { allow read, write: if true; }
    match /recommendationRequests/{id}  { allow read, write: if true; }
    match /portalState/{id}             { allow read, write: if true; }

    // Audit trail: entries can be added and read, never edited or deleted.
    match /auditTrail/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
