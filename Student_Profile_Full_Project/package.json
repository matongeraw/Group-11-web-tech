{
  "name": "africa-university-student-profile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "emulators": "firebase emulators:start --project demo-myau-passport --only auth,firestore,storage",
    "server": "node backend/server.js",
    "start": "node backend/server.js",
    "dev:full": "concurrently \"npm:server\" \"npm:dev\"",
    "lint": "eslint src backend --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "set-role": "node scripts/set-user-role.js",
    "test:backend": "firebase emulators:exec --project demo-myau-passport --only auth,firestore \"node scripts/run-emulator-tests.js tests/backend\"",
    "test:security": "firebase emulators:exec --project demo-myau-passport --only firestore,storage \"vitest run tests/security\"",
    "test": "firebase emulators:exec --project demo-myau-passport --only auth,firestore,storage \"node scripts/run-emulator-tests.js tests/backend tests/security\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^11.1.0",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "firebase-tools": "^13.29.2",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
