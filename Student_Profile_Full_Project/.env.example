# Frontend Firebase web app configuration (safe to expose in browser, protected by Firebase rules)
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# Backend configuration. Keep secrets out of GitHub.
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# Option A: path to downloaded service-account JSON, outside this repository
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json
# Option B: one-line JSON string instead of GOOGLE_APPLICATION_CREDENTIALS
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
