rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    match /profiles/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin()) && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /documents/{uid}/{fileName} {
      allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin() || request.auth.token.role == 'lecturer');
    }
  }
}
