rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function isAdmin() { return role() == 'admin'; }
    function isLecturer() { return role() == 'lecturer'; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || (isLecturer() && resource.data.role == 'student'));
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'student' && request.resource.data.status == 'active';
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status;
      allow delete: if isAdmin();
    }
    match /students/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || (isLecturer() && resource.data.role == 'student'));
      allow write: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    match /lecturers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isLecturer();
    }
    match /documents/{id} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin() || isLecturer());
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }
    match /activity_logs/{id} { allow read: if isAdmin(); allow create: if signedIn(); allow update, delete: if false; }
    match /system_settings/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
